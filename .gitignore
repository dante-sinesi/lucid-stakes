# Godot
.godot/
*.translation
export_presets.cfg.bak

# El ejecutable de Godot (se descarga aparte, pesa más de 100 MB)
tools/*.exe

# Capturas y archivos temporales de las pruebas
*.tmp
tests/_*.gd
tests/_*.jsonl

build/

# Salas generadas (las fuentes del paquete de salas y lo que sale de los generadores no se versionan: viaja data/salas_torre.jsonl)
/bibliotecas/
/capturas/

tests/resultados.txt

# La extensión de Godot del solucionador (native/construir_extension.bat): godot-cpp se baja aparte y lo que se arma no se versiona
/native/godot-cpp/
/native/extension/.sconsign.dblite
/native/extension/.scons_cache/
/extension/bin/
*.obj
*.o
*.a
*.exp
