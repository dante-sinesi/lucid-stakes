#!/usr/bin/env python
# La extensión de Godot del solucionador de salas (ver docs/solver_extension.md). Se arma con native\construir_extension.bat.
# Deja la biblioteca en extension/bin/ (el proyecto la carga con extension/solver.gdextension).

env = SConscript("../godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

library = env.SharedLibrary("../../extension/bin/libsolver{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources)
Default(library)
