# Acentos: filas 0 y 1 de la grilla (encima del cuerpo).
const ACCENTS := {
	"acute": ["...#.", "..#.."],
	"diaeresis": [".....", ".#.#."],
	"tilde": [".##.#", "....."],
}

# Letras con acento: char -> [base, acento]
const ACCENTED := {
	"á": ["a", "acute"], "é": ["e", "acute"], "í": ["i", "acute"], "ó": ["o", "acute"], "ú": ["u", "acute"], "ü": ["u", "diaeresis"],
	"ñ": ["n", "tilde"],
	"Á": ["A", "acute"], "É": ["E", "acute"], "Í": ["I", "acute"], "Ó": ["O", "acute"], "Ú": ["U", "acute"], "Ü": ["U", "diaeresis"],
	"Ñ": ["N", "tilde"],
}


## Celdas encendidas de un carácter dentro de su casillero de W x H: Array de Vector2i (x, y).
static func glyph_cells(ch: String) -> Array[Vector2i]:
	var out: Array[Vector2i] = []
	var base := ch
	var accent := ""
	if ACCENTED.has(ch):
		base = ACCENTED[ch][0]
		accent = ACCENTED[ch][1]
	var rows: Array = G.get(base, G["?"])
	for r in rows.size():
		var line: String = rows[r]
		for x in line.length():
			if line[x] == "#":
				# El punto de la i con acento se reemplaza por el acento.
				if accent != "" and base == "i" and r == 0:
					continue
				out.append(Vector2i(x, ACCENT_ROWS + r))
	if accent != "":
		var arows: Array = ACCENTS[accent]
		for r in arows.size():
			var line: String = arows[r]
			for x in line.length():
				if line[x] == "#":
					out.append(Vector2i(x, r))
	return out


## Ancho (en celdas) de una línea de texto.
static func line_width(text: String) -> int:
	if text == "":
		return 0
	var ultimo: Array = G.get(text[text.length() - 1], G["?"])
	return text.length() * ADVANCE - 1 + maxi(0, str(ultimo[0]).length() - W)   # (un glifo ancho al final sobresale)


## Parte un texto en líneas de a lo sumo `max_cells` celdas de ancho (corta por palabras; respeta los saltos de línea).
static func wrap(text: String, max_cells: int) -> Array[String]:
	text = text.replace("", "")   # por si el texto viene de un archivo con saltos de línea de Windows
	var out: Array[String] = []
	var max_chars := maxi((max_cells + 1) / ADVANCE, 1)
	for para in text.split("\n"):
		if para == "":
			out.append("")
			continue
		var line := ""
		for word in para.split(" "):
			var candidate := word if line == "" else line + " " + word
			if candidate.length() <= max_chars:
				line = candidate
			else:
				if line != "":
					out.append(line)
				while word.length() > max_chars:  # una palabra más larga que la línea se corta
					out.append(word.substr(0, max_chars))
					word = word.substr(max_chars)
				line = word
		out.append(line)
	return out


## Celdas de un texto (una o varias líneas): {cells: Array[Vector2i], size: Vector2i} en celdas. `align`: 0 izquierda, 1 centro, 2 derecha.
static func layout(lines: Array, align := 0) -> Dictionary:
	var width := 0
	for l in lines:
		width = maxi(width, line_width(l))
	var cells: Array[Vector2i] = []
	for i in lines.size():
		var line: String = lines[i]
		var off := 0
		if align == 1:
			off = (width - line_width(line)) / 2
		elif align == 2:
			off = width - line_width(line)
		for c in line.length():
			for cell in glyph_cells(line[c]):
				cells.append(Vector2i(off + c * ADVANCE + cell.x, i * LINE_H + cell.y))
	var height := lines.size() * LINE_H - (LINE_H - H) if lines.size() > 0 else 0
	return {"cells": cells, "size": Vector2i(width, height)}
